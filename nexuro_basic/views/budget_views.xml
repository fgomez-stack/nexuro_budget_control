<odoo>
    <record id="view_budget_list" model="ir.ui.view">
        <field name="name">budget.list</field>
        <field name="model">nexuro.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department"/>
                <field name="budget_amount"/>
                <field name="spent_amount"/>
                <field name="remaining_amount"/>
            </list>
        </field>
    </record>

    <record id="view_budget_form" model="ir.ui.view">
        <field name="name">budget.form</field>
        <field name="model">nexuro.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="department"/>
                        <field name="budget_amount"/>
                        <field name="spent_amount"/>
                        <field name="remaining_amount"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="description"/>
                            <field name="amount"/>
                            <!-- Campo nuevo para adjuntar documento -->
                            <field name="attachment" filename="attachment_name" widget="binary"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_budget" model="ir.actions.act_window">
        <field name="name">Budget</field>
        <field name="res_model">nexuro.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_root" name="Nexuro"/>
    <menuitem id="menu_budget" parent="menu_root" action="action_budget"/>
</odoo>
